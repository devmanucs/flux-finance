NEXT_PUBLIC_API_URL="http://localhost:4000"
# Produção (Vercel): NEXT_PUBLIC_API_URL="/api" e API_PROXY_URL com a URL da
# API no Render (ex.: https://flux-finance-api.onrender.com). O Next repassa
# /api/* pra lá e o cookie de sessão vira do próprio site (sem isso o login
# entra em loop no Safari/iOS, que bloqueia cookie de terceiros).
# API_PROXY_URL=""
# Ative somente para testar conectores sandbox da Pluggy.
NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=false
