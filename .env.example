# Este projeto é um monorepo: cada app/package lê o próprio .env (não um
# único .env na raiz). Este arquivo é só um resumo de onde configurar o quê.
#
# packages/database/.env
#   DATABASE_URL="postgresql://postgres.<PROJETO>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
#   DIRECT_URL="postgresql://postgres.<PROJETO>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
#
# apps/api/.env
#   PORT=4000
#   WEB_APP_URL="http://localhost:3000"
#   PLUGGY_CLIENT_ID="..."
#   PLUGGY_CLIENT_SECRET="..."
#   API_PUBLIC_URL="https://api.seu-dominio.com"
#   PLUGGY_WEBHOOK_SECRET="..."
#   CRON_SECRET="..."
#   REPORT_USER_EMAIL="voce@exemplo.com"
#   CALLMEBOT_PHONE="+5511999999999"
#   CALLMEBOT_API_KEY="..."
#
# apps/web/.env.local
#   NEXT_PUBLIC_API_URL="http://localhost:4000"
#   NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=false
#
# Banco: Postgres hospedado no Supabase (não precisa de banco local/Docker).
# Pegue a connection string em Supabase > Project Settings > Database.
