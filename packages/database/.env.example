# Runtime: pooler do Supabase em modo transação (porta 6543). O modo sessão
# (5432) limita a 15 clientes e a sync do Pluggy estoura esse limite.
# Caracteres especiais da senha precisam ir codificados (@ -> %40, * -> %2A).
DATABASE_URL="postgresql://postgres.<PROJETO>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations (prisma migrate) precisam da conexão de sessão.
DIRECT_URL="postgresql://postgres.<PROJETO>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
SEED_USER_EMAIL="demo@flux.finance"
SEED_USER_PASSWORD="troque-esta-senha"
