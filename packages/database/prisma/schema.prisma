generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionKind {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
  MEAL_VOUCHER
}

// IDs como Int/autoincrement (não BigInt): evita o gotcha de serialização
// de BigInt em JSON (Nest/Express) — aceitável pro volume de um app de
// finanças pessoais. Datas em timestamptz e dinheiro em Decimal(12,2), não
// Float, seguindo as boas práticas de Postgres do Supabase.

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz() @map("updated_at")
  accounts     Account[]
  pluggyConnections PluggyConnection[]

  @@map("users")
}

model Account {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType   @default(CHECKING)
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  currency     String        @default("BRL")
  // Dia do mês (1-31) em que a fatura/conta vence; null = sem
  // acompanhamento de status. Recorrente: não precisa recadastrar todo mês.
  dueDay       Int?          @map("due_day")
  // Quando a fatura do ciclo atual foi marcada como paga; comparado ao
  // início do ciclo (derivado de dueDay) para saber se ainda vale pro ciclo
  // atual ou se é de um ciclo anterior (ver accounts.service.ts).
  paidAt       DateTime?     @db.Timestamptz() @map("paid_at")
  // Dinheiro "guardado" (poupança/investimento reservado): soma no
  // patrimônio líquido mas fica de fora do saldo total (gasto disponível).
  isReserved   Boolean       @default(false) @map("is_reserved")
  pluggyAccountId String?    @unique @map("pluggy_account_id")
  pluggyConnectionId Int?    @map("pluggy_connection_id")
  pluggyConnection PluggyConnection? @relation(fields: [pluggyConnectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt    DateTime      @updatedAt @db.Timestamptz() @map("updated_at")
  transactions Transaction[]

  @@index([userId])
  @@index([userId, dueDay, paidAt])
  @@index([pluggyConnectionId])
  @@map("accounts")
}

model PluggyConnection {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId           String        @unique @map("item_id")
  institutionName  String        @map("institution_name")
  status           String        @default("UPDATED")
  lastSyncedAt     DateTime?     @db.Timestamptz() @map("last_synced_at")
  createdAt        DateTime      @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt        DateTime      @updatedAt @db.Timestamptz() @map("updated_at")
  accounts         Account[]

  @@index([userId])
  @@map("pluggy_connections")
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String
  kind         TransactionKind @default(EXPENSE)
  color        String?
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  id          Int             @id @default(autoincrement())
  accountId   Int             @map("account_id")
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  Int?            @map("category_id")
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  kind        TransactionKind @default(EXPENSE)
  date        DateTime        @default(now()) @db.Timestamptz()
  // Vencimento pontual da transação (ex.: boleto, aluguel); null = sem
  // acompanhamento de status. Diferente do dueDay da conta (recorrente por
  // ciclo) — aqui é uma data fixa, já que cada lançamento é uma ocorrência.
  dueDate     DateTime?       @db.Timestamptz() @map("due_date")
  isPaid      Boolean         @default(false) @map("is_paid")
  pluggyTransactionId String? @unique @map("pluggy_transaction_id")
  createdAt   DateTime        @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt   DateTime        @updatedAt @db.Timestamptz() @map("updated_at")

  @@index([accountId])
  @@index([categoryId])
  @@index([accountId, dueDate, isPaid])
  @@map("transactions")
}

model PluggyWebhookEvent {
  id                  Int      @id @default(autoincrement())
  eventId             String   @unique @map("event_id")
  event               String
  payload             Json
  status              String   @default("QUEUED")
  attempts            Int      @default(0)
  lastError           String?  @map("last_error")
  receivedAt          DateTime @default(now()) @db.Timestamptz() @map("received_at")
  processingStartedAt DateTime? @db.Timestamptz() @map("processing_started_at")
  nextAttemptAt       DateTime? @db.Timestamptz() @map("next_attempt_at")
  processedAt         DateTime? @db.Timestamptz() @map("processed_at")

  @@index([status, nextAttemptAt, receivedAt])
  @@map("pluggy_webhook_events")
}

model Budget {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  limit      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt  DateTime @updatedAt @db.Timestamptz() @map("updated_at")

  @@index([categoryId])
  @@map("budgets")
}
